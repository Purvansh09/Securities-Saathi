# Copy to .env.local and fill in. Vite only exposes variables prefixed with VITE_ to the browser,
# so nothing secret may ever go in this file -- everything here ends up in the public JS bundle.

# Supabase dashboard > Project Settings > Data API. The bare project URL, no /rest/v1/ suffix.
VITE_SUPABASE_URL=https://vmonemnomwyjwacagkuc.supabase.co

# Supabase dashboard > Project Settings > API Keys > Publishable key. Public by design.
# The frontend uses Supabase only for auth (CLAUDE.md stack); all data goes through our FastAPI backend.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where the FastAPI backend runs.
VITE_API_URL=http://127.0.0.1:8000
