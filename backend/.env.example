# Copy to .env and fill in. Never commit .env (it's gitignored).

# From Supabase dashboard > Project Settings > Data API
SUPABASE_URL=https://vmonemnomwyjwacagkuc.supabase.co

# From Supabase dashboard > Project Settings > Data API > JWT Settings > Legacy JWT secret.
# Used to verify the JWT the frontend sends on every request. Not the anon/publishable key.
SUPABASE_JWT_SECRET=

# From Supabase dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...).
# Public by design. The backend sends it only as the apikey header when fetching the
# JWKS public keys used to verify ES256 user tokens (see app/core/auth.py).
SUPABASE_PUBLISHABLE_KEY=

# Direct Postgres connection, used by the backend's asyncpg pool.
# This connection bypasses RLS, so every query MUST be scoped by user_id from the verified JWT (see CLAUDE.md rule 13).
# From Supabase dashboard > Project Settings > Database > Connection string (URI, "Session pooler" for a normal
# backend, or the direct connection if you disable pgbouncer). Fill in the real password — it's set once at
# project creation or reset from that same page.
DATABASE_URL=postgresql://postgres.vmonemnomwyjwacagkuc:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Shared secret the sync/refresh cron jobs must send in an X-Internal-Secret header.
# Generate one yourself, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SYNC_SECRET=
